{
    # Certificates for customer domains are issued on first request, but only for
    # hostnames the app confirms (verified custom domains or our own domain).
    on_demand_tls {
        ask http://app:8080/internal/tls-ask
    }
}

{$DOMAIN} {
    encode gzip
    reverse_proxy app:8080
}

# Customer domains (published pages only; the app enforces this).
https:// {
    tls {
        on_demand
    }
    encode gzip
    reverse_proxy app:8080
}
