@page "/signup"
@layout LandingLayout
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<AppDb> DbFactory
@inject NavigationManager Nav

<PageTitle>Create your account · Foundrmind</PageTitle>
<div class="lp lp-auth">
    <a class="lp-brand" href="/"><img src="favicon.svg" alt="" width="32" height="32" /> Foundrmind</a>
    <div class="lp-auth-card">
        <h1>Start building free</h1>
        <p class="lp-muted">30 AI runs a month, all modules, no credit card.</p>
        @if (error != null) { <div class="lp-alert">@error</div> }
        <EditForm Model="Input" FormName="signup" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <label>Your name<InputText @bind-Value="Input.Name" autocomplete="name" /></label>
            <label>Email<InputText @bind-Value="Input.Email" type="email" autocomplete="email" /></label>
            <label>Password <small>(at least 8 characters)</small><InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" /></label>
            <ValidationSummary />
            <button class="lp-btn" type="submit">Create account</button>
        </EditForm>
        <p class="lp-muted lp-auth-alt">By signing up you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.<br />Already have an account? <a href="/login">Log in</a></p>
    </div>
</div>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] SignupModel Input { get; set; } = new();
    string? error;

    async Task Submit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var email = Input.Email.Trim().ToLowerInvariant();
        if (await db.Users.AnyAsync(u => u.Email == email))
        {
            error = "An account with this email already exists. Try logging in.";
            return;
        }
        var user = new User { Email = email, Name = Input.Name.Trim(), PasswordHash = Passwords.Hash(Input.Password) };
        db.Users.Add(user);
        await db.SaveChangesAsync();
        await AuthHelper.SignIn(HttpContext, user);
        Nav.NavigateTo("/app/new", forceLoad: true);
    }

    public class SignupModel
    {
        [Required, StringLength(80)] public string Name { get; set; } = "";
        [Required, EmailAddress, StringLength(200)] public string Email { get; set; } = "";
        [Required, StringLength(200, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")] public string Password { get; set; } = "";
    }
}
